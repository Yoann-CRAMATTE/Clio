{
  "id": "./",
  "name": "Clio — L'atelier de l'écrivain",
  "short_name": "Clio",
  "description": "Traitement de texte pour romanciers : chapitres, scènes, notes et objectifs.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5efe0",
  "theme_color": "#1a1208",
  "categories": ["productivity", "books"],
  "icons": [
    { "src": "icons/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-clio": [".clio"] },
      "icons": [{ "src": "icons/icone-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
